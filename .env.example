# Copy to .env for the live demo.
# Enables demo-only features: "Simulate manual change" and simulated transient failures.
LZ_DEMO_MODE=true
# First apply attempt of these accounts fails with a simulated ThrottlingException (comma-separated).
LZ_SIMULATE_TRANSIENT=ns-booking-test
# Accounts deployed in parallel per ring (default 3). Raise for the scale demo (lz seed --synthetic).
# LZ_MAX_PARALLEL=8
