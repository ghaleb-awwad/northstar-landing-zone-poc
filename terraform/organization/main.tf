# Organization root: OUs, one SCP per OU (with exception exemptions) and account placement.
# Applied in stages, one workspace (= one state) per stage, so SCP changes follow the rings:
#   core       Root and the shared OUs (Security, Infrastructure, Workloads) + core accounts.
#              Affects every account, so the pipeline treats it as a Prod change (approval).
#   dev|test|prod  The environment's OU, its SCP and the placement of its accounts.
# Simulated: written to organization/<stage>.json instead of AWS Organizations.

terraform {
  required_version = ">= 1.5"
  required_providers {
    local = { source = "hashicorp/local", version = "~> 2.5" }
  }
  backend "local" {
    workspace_dir = "../../.lz/state/organization"
  }
}

variable "config_dir" { type = string }
variable "estate_dir" { type = string }
variable "synthetic_dir" {
  description = "Optional extra account files (generated by lz seed --synthetic)."
  type        = string
  default     = ""
}

locals {
  stage           = terraform.workspace
  org             = yamldecode(file("${var.config_dir}/organization.yaml"))
  global          = yamldecode(file("${var.config_dir}/global.yaml"))
  exceptions      = yamldecode(file("${var.config_dir}/exceptions.yaml")).exceptions
  envs            = { for f in fileset("${var.config_dir}/environments", "*.yaml") : trimsuffix(f, ".yaml") => yamldecode(file("${var.config_dir}/environments/${f}")) }
  synthetic_files = var.synthetic_dir == "" ? toset([]) : fileset(var.synthetic_dir, "*.yaml")
  accounts = merge(
    { for f in fileset("${var.config_dir}/accounts", "*.yaml") : trimsuffix(f, ".yaml") => yamldecode(file("${var.config_dir}/accounts/${f}")) },
    { for f in local.synthetic_files : trimsuffix(f, ".yaml") => yamldecode(file("${var.synthetic_dir}/${f}")) },
  )

  env_of_ou = { for env, e in local.envs : e.ou => env }

  # OUs and accounts owned by this stage.
  stage_ous = {
    for name, ou in local.org.ous : name => ou
    if lookup(local.env_of_ou, name, "core") == local.stage
  }
  stage_statements = distinct(flatten([for ou in values(local.stage_ous) : ou.scp]))
  stage_accounts = merge(
    { for a in local.org.core_accounts : a.name => { id = a.id, ou = a.ou, type = "core" } if local.stage == "core" },
    { for name, a in local.accounts : name => { id = a.account_id, ou = local.envs[a.environment].ou, type = "workload" } if a.environment == local.stage },
  )

  # Active exceptions for statements this stage attaches (env stages: only for their own accounts).
  active_exceptions = [
    for e in local.exceptions : e
    if timecmp(plantimestamp(), "${e.expires}T23:59:59Z") <= 0 &&
    contains(local.stage_statements, try(e.scp_statement, "")) &&
    (local.stage == "core" || local.accounts[e.account].environment == local.stage)
  ]
  exemptions = {
    for s in distinct([for e in local.active_exceptions : e.scp_statement]) :
    s => [for e in local.active_exceptions : local.accounts[e.account].account_id if e.scp_statement == s]
  }
}

resource "terraform_data" "guardrails" {
  lifecycle {
    precondition {
      condition     = contains(concat(["core"], keys(local.envs)), local.stage)
      error_message = "Workspace must be an organization stage: core, ${join(", ", keys(local.envs))}."
    }
  }
}

module "scp" {
  source   = "../modules/scp"
  for_each = { for name, ou in local.stage_ous : name => tolist(ou.scp) if length(ou.scp) > 0 }

  statements      = each.value
  allowed_regions = local.global.allowed_regions
  exemptions      = local.exemptions
}

resource "local_file" "organization" {
  filename = "${var.estate_dir}/organization/${local.stage}.json"
  content = jsonencode({
    stage      = local.stage
    ous        = { for name, ou in local.stage_ous : name => { parent = try(ou.parent, null), scp = ou.scp } }
    policies   = { for name, m in module.scp : name => jsondecode(m.document) }
    exemptions = local.exemptions
    accounts   = local.stage_accounts
  })
}
