{
  "name": "northstar-landing-zone-poc",
  "version": "1.0.0",
  "private": true,
  "description": "NorthStar Airlines landing zone governance proof of concept (simulated AWS).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "lz": "tsx src/cli.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tf:init": "terraform -chdir=terraform/organization init -input=false && terraform -chdir=terraform/account init -input=false",
    "demo:reset": "tsx src/cli.ts seed --reset-demo-config"
  },
  "dependencies": {
    "express": "^5.3.0",
    "p-limit": "^6.2.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
